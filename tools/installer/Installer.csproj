<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KH3RM_AR_Setup</AssemblyName>
    <RootNamespace>Kh3rmAr</RootNamespace>
    <Version>0.8.2</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- the pak to embed; override with -p:PakPath=... -->
    <PakPath Condition="'$(PakPath)'==''">$(MSBuildThisFileDirectory)..\..\out\builds\BUILD-7\pakchunk99-arabic_P.pak</PakPath>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PakPath)" LogicalName="pak" />
    <EmbeddedResource Include="art\background.png" Condition="Exists('art\background.png')" LogicalName="art.bg" />
    <EmbeddedResource Include="art\CREDIT.txt" Condition="Exists('art\CREDIT.txt')" LogicalName="art.credit" />
  </ItemGroup>
</Project>
