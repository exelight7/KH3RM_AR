<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KH3RM_AR_Setup</AssemblyName>
    <RootNamespace>Kh3rmAr</RootNamespace>
    <Version>1.0.0-rc.2</Version>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <PakPath Condition="'$(PakPath)'==''">$(MSBuildThisFileDirectory)..\..\out\builds\BUILD-18\pakchunk99-arabic_P.pak</PakPath>
    <ImagesPakPath Condition="'$(ImagesPakPath)'==''">$(MSBuildThisFileDirectory)..\..\out\builds\IMAGES-MASS11\pakchunk98-arabic-images_P.pak</ImagesPakPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <Compile Include="Program.cs;App.axaml.cs;MainWindow.axaml.cs;Core.cs;Strings.cs;SelfTest.cs" />
    <AvaloniaResource Include="art/hero.jpg" />
    <EmbeddedResource Include="$(PakPath)" LogicalName="pak" />
    <EmbeddedResource Include="$(ImagesPakPath)" LogicalName="pak.images" />
  </ItemGroup>
  <Target Name="CheckPaks" BeforeTargets="Build">
    <Error Condition="!Exists('$(PakPath)')" Text="Text pak missing: $(PakPath)" />
    <Error Condition="!Exists('$(ImagesPakPath)')" Text="Images pak missing: $(ImagesPakPath)" />
  </Target>
</Project>
