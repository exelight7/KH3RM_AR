<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Kh3rmAr.MainWindow" Title="KH3RM_AR" Width="1080" Height="700" MinWidth="980" MinHeight="660"
 WindowStartupLocation="CenterScreen" SystemDecorations="None" CanResize="False" Background="#121219"
 FontFamily="Segoe UI, Noto Sans Arabic, DejaVu Sans" UseLayoutRounding="True">
 <Border BorderBrush="#393543" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
  <Grid ColumnDefinitions="*,460">
   <Grid Grid.Column="0" ClipToBounds="True">
    <Image Source="/art/hero.jpg" Stretch="UniformToFill" HorizontalAlignment="Center"/>
    <Border><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#55101A2E" Offset="0"/><GradientStop Color="#00101A2E" Offset="0.35"/><GradientStop Color="#33121A2A" Offset="0.60"/><GradientStop Color="#F50C1423" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    <Border Width="270" HorizontalAlignment="Right"><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#00121219" Offset="0"/><GradientStop Color="#55121219" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    <Grid Margin="36,25,36,36" RowDefinitions="Auto,*,Auto">
     <StackPanel Orientation="Horizontal" Spacing="9" PointerPressed="TitleDrag">
      <TextBlock Text="♔" FontSize="24" Foreground="#F8E6B8"/><TextBlock Text="KH3RM_AR" FontWeight="SemiBold" FontSize="14" LetterSpacing="2" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Spacing="12">
      <Border BorderBrush="#667E94AC" BorderThickness="1" CornerRadius="20" Padding="13,6" HorizontalAlignment="Left" Background="#44101A2A"><TextBlock x:Name="ArtBadge" Text="KINGDOM HEARTS III  /  RE MIND" FontSize="10" LetterSpacing="2" Foreground="#DCEAF2"/></Border>
      <TextBlock x:Name="HeroTitle" Text="حكايتك، بلغتك." FontSize="38" FontWeight="SemiBold" FlowDirection="RightToLeft" TextAlignment="Right"/>
      <TextBlock x:Name="HeroCaption" Text="عالم تعرفه. إحساس أقرب." FontSize="15" Foreground="#C0D0DF" FlowDirection="RightToLeft" TextAlignment="Right"/>
      <Border Height="2" Width="50" Background="#E8CA89" HorizontalAlignment="Right" Margin="0,4,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
   <Grid Grid.Column="1" RowDefinitions="54,*,42" Background="#121219">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,9,13,0" PointerPressed="TitleDrag">
     <TextBlock x:Name="VerText" Foreground="#85818E" FontSize="11" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
      <Button x:Name="LangBtn" Classes="chrome" Click="LangClick" AutomationProperties.Name="Switch language"/>
      <Button Classes="chrome" Content="—" Click="MinClick" AutomationProperties.Name="Minimize"/>
      <Button Classes="chrome" Content="×" Click="CloseClick" AutomationProperties.Name="Close"/>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="Panel" Grid.Row="1" Margin="32,25,32,12" Spacing="0" FlowDirection="RightToLeft">
     <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16"><Border Background="#E8CA89" Width="5" Height="5" CornerRadius="3" VerticalAlignment="Center"/><TextBlock Text="ARABIC EDITION" FontSize="10" Foreground="#D4B77B" LetterSpacing="3"/></StackPanel>
     <TextBlock x:Name="TitleText" Text="رحلتك تبدأ&#10;بلغتك." FontSize="38" FontWeight="SemiBold" LineHeight="51"/>
     <TextBlock x:Name="SubText" Text="تعريب كينغدوم هارتس III + Re Mind" Foreground="#A7A0AE" FontSize="14" Margin="0,12,0,25" TextWrapping="Wrap"/>
     <Border Background="#1B1B25" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,0,0,22">
      <StackPanel Orientation="Horizontal" Spacing="9"><Border x:Name="Dot" Width="6" Height="6" CornerRadius="3" Background="#D8B975" VerticalAlignment="Center"/><TextBlock x:Name="StateText" FontSize="12" Foreground="#C9C1D0" TextWrapping="Wrap" MaxWidth="305"/></StackPanel>
     </Border>
     <TextBlock x:Name="FolderLabel" FontSize="12" Foreground="#B5ACBC" Margin="0,0,0,9"/>
     <Grid ColumnDefinitions="*,Auto" FlowDirection="LeftToRight" Margin="0,0,0,8">
      <TextBox x:Name="PathText" IsReadOnly="True" TextWrapping="NoWrap" Watermark="Steam / Epic / Proton" AutomationProperties.Name="Game folder"/>
      <Button x:Name="BrowseBtn" Grid.Column="1" Classes="secondary" Margin="8,0,0,0" Click="BrowseClick"/>
     </Grid>
     <TextBlock x:Name="DetectText" FontSize="11" Foreground="#797180" Margin="0,0,0,12" TextWrapping="Wrap"/>
     <CheckBox x:Name="ImagesCheck" FontSize="12" Foreground="#C9C1D0" Margin="0,0,0,12" AutomationProperties.Name="Images pack"/>
     <Button x:Name="InstallBtn" Classes="install" HorizontalAlignment="Stretch" Click="InstallClick"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,5,0,0">
      <Button x:Name="RemoveBtn" Classes="chrome" Click="RemoveClick" FontSize="12"/>
      <Button x:Name="RemoveImgBtn" Classes="chrome" Click="RemoveImgClick" FontSize="12" IsVisible="False"/>
     </StackPanel>
     <ProgressBar x:Name="BusyBar" IsVisible="False" IsIndeterminate="True" Height="3" Margin="0,5,0,0" Foreground="#E8CA89"/>
     <TextBlock x:Name="MsgText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="55"/>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="32,0,32,12">
     <TextBlock x:Name="PlatformText" Text="WINDOWS  ·  LINUX" Foreground="#66616F" FontSize="9" LetterSpacing="1.5" VerticalAlignment="Center"/>
     <CheckBox x:Name="LogCheck" Grid.Column="1" FontSize="10" Foreground="#8A8292" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
